# Copy this file to config/.env and replace the placeholder values.
# Flutter does not load this file automatically; use the command in README.md.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY

# Production and shared builds call the authenticated Edge Function. This URL
# is safe to compile into Flutter; the provider key remains on the server.
WORK_LIFE_AI_PROXY_URL=
AIMLAPI_MODEL=google/gemini-3-8-flash

# Debug-only direct provider access. Never enable this for a release build.
ALLOW_INSECURE_LOCAL_AI=true
AIMLAPI_KEY=replace_with_your_key
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
